# =============================================================================
# FlashArcPay Nusantara — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
#
# Arc decimal model (read before editing):
#   ERC-20 view  : 6 decimals  — balances, transfers, approvals, display
#   Native view  : 18 decimals — gas / msg.value ONLY
#   Same asset, same pool. NEVER sum or swap these two views.
#   Conversion: 1 ERC-20 unit = 10^12 native units.
# =============================================================================

# -----------------------------------------------------------------------------
# Arc Network — choose ONE set (testnet or mainnet)
# -----------------------------------------------------------------------------

# --- TESTNET (default for development) ---
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_EXPLORER=https://explorer.testnet.arc.io

# --- MAINNET (production — real USDC, irreversible transactions) ---
# VITE_ARC_CHAIN_ID=5042
# VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
# VITE_ARC_EXPLORER=https://explorer.arc.io

# -----------------------------------------------------------------------------
# USDC Token Address
# Fixed predeploy — SAME address on both testnet and mainnet.
# -----------------------------------------------------------------------------
VITE_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# FlashArcPay Contract Address
# Set this after deploying the contract.
#   Testnet deploy : npx hardhat run scripts/deploy.js --network arcTestnet
#   Mainnet deploy : npx hardhat run scripts/deploy-mainnet.js --network arcMainnet
# -----------------------------------------------------------------------------
VITE_FLASH_ARC_PAY_ADDRESS=

# -----------------------------------------------------------------------------
# Deployment keys (contracts/ directory only — never exposed to frontend)
# -----------------------------------------------------------------------------

# Testnet deployer (fine to use .env in development)
PRIVATE_KEY=

# Mainnet deployer — use an encrypted keystore in production, not a raw key.
# See: https://book.getfoundry.sh/reference/cast/cast-wallet-import
DEPLOYER_PRIVATE_KEY=

# Arc RPC URLs for Hardhat (optional overrides)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# -----------------------------------------------------------------------------
# Arc Studio RPC proxy (injected by Arc Studio — do not set manually)
# -----------------------------------------------------------------------------
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
